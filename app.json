{
  "expo": {
    "name": "Walki",
    "slug": "walki",
    "scheme": "walki",
    "orientation": "portrait",
    "icon": "./assets/images/icons/icon.png",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.vijayenderthakur.walki",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icons/icon.png",
        "backgroundColor": "#E8F1FF"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "favicon": "./assets/images/icons/favicon.png"
    },
    "plugins": [
      "expo-router",
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7FAFF",
          "image": "./assets/images/walki-logo-boy.png",
          "imageWidth": 220,
          "resizeMode": "contain"
        }
      ],
      "expo-audio",
      "expo-asset",
      [
        "expo-notifications",
        {
          "sounds": ["./assets/sounds/sos_alert.wav"]
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7a47db2a-567d-4242-b982-630d0b2c9bfd"
      }
    },
    "ios": {
      "bundleIdentifier": "com.vijayenderthakur.walki",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    }
  }
}
